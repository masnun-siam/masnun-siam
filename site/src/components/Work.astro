---
import { getCollection } from 'astro:content';
import { monthLabel, sortRoles } from '../lib/work.ts';
import Section from './Section.astro';

const roles = sortRoles((await getCollection('work')).map((r) => r.data));

// A company sits where its newest role is; Map keeps first-insertion order.
const groups = new Map<string, typeof roles>();
for (const role of roles) groups.set(role.company, [...(groups.get(role.company) ?? []), role]);
---

<Section id="work" title="work">
	{
		roles.length === 0 ? (
			<p>-- no entries --</p>
		) : (
			<ul class="companies">
				{[...groups].map(([company, list]) => (
					<li data-testid="company-group">
						<h3>{company}</h3>
						<ul class="roles">
							{list.map((role) => (
								<li data-testid="role">
									<h4>{role.title}</h4>
									<p class="meta">
										{role.location} · {role.mode} ·{' '}
										<time datetime={role.start}>{monthLabel(role.start)}</time> –{' '}
										{role.end ? <time datetime={role.end}>{monthLabel(role.end)}</time> : 'Present'}
									</p>
									<ul class="highlights">
										{role.highlights.map((h) => (
											<li>{h}</li>
										))}
									</ul>
									<ul class="tags">
										{role.tags.map((t) => (
											<li>{t}</li>
										))}
									</ul>
								</li>
							))}
						</ul>
					</li>
				))}
			</ul>
		)
	}
</Section>

<style>
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.companies > li + li {
		margin-top: 1.5rem;
	}

	h3 {
		margin: 0 0 0.5rem;
		font-size: 1.1rem;
	}

	.roles > li {
		padding-left: 1rem;
		border-left: 1px solid var(--border);
	}

	.roles > li + li {
		margin-top: 1rem;
	}

	h4 {
		margin: 0;
		font-size: 1rem;
	}

	.meta {
		margin: 0.25rem 0 0.5rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.875rem;
	}

	.highlights {
		list-style: disc;
		padding-left: 1.25rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
		margin-top: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--muted);
	}

	.tags li::before {
		content: '#';
	}
</style>
